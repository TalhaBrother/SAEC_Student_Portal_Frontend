{
  "name": "client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "public/main.js",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",

    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",

    "electron:build": "npm run build:electron && electron-builder"
  },

  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "axios": "^1.18.0",
    "chart.js": "^4.5.1",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router": "^7.18.0",
    "sweetalert2": "^11.26.25",
    "zustand": "^5.0.14"
  },

  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },

  "build": {
    "appId": "com.saec.studentportal",
    "productName": "SAEC Student Portal",

    "directories": {
      "output": "release"
    },

    "files": [
      "public/**/*",
      "package.json"
    ],

    "extraResources": [
      {
        "from": "../Server/Backend/dist/serve",
        "to": "backend",
         "filter": [
      "**/*"
    ]
      },
       {
    "from": "../Server/Backend/.env",
    "to": ".env"
  },
      {
        "from": "dist",
        "to": "frontend/dist"
      }
    ],

    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}